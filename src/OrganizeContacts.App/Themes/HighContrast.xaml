<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Follow the active Windows High Contrast palette instead of overriding it. -->
    <SolidColorBrush x:Key="BaseBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="MantleBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="CrustBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Surface0Brush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Surface1Brush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Overlay0Brush" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="Overlay1Brush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Subtext0Brush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Subtext1Brush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AccentAltBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{x:Static SystemColors.WindowTextColor}" />

</ResourceDictionary>
